{
  "name": "Flutter-Python Teaching Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shellIntegration.enabled": true
      },
      "extensions": [
        "eamodio.gitlens"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/setup-git-reminder.sh",
  "postAttachCommand": "bash .devcontainer/check-git-status.sh",

  "remoteUser": "codespace"
}
