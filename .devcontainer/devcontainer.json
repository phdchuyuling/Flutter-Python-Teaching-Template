{
  "name": "Flutter Reversi Game",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/flutter:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter App",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "export PATH=/opt/flutter/flutter/bin:$PATH && flutter pub get && flutter build web",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter/flutter",
        "dart.enableSdkFormatter": true
      }
    }
  }
}
